# Cloudflare Pages security headers. Applied to every response.
# https://developers.cloudflare.com/pages/configuration/headers/
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # No 'unsafe-inline' in script-src: every script is an external file (the
  # Astro config stops it inlining small bundles) except the JSON-LD block,
  # which is a data block browsers never execute, so the CSP ignores it. The
  # one third-party origin allowed is challenges.cloudflare.com, the Turnstile
  # widget (its script, its verification XHR via connect-src, and the iframe
  # it renders via frame-src); the widget sets inline styles on that iframe,
  # which is why style-src keeps 'unsafe-inline'. Everything else stays
  # locked to 'self'. test/built-site.test.mjs checks dist/ against this.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests

# The *.pages.dev deployments (production alias and every branch preview) are
# public copies of the site. Canonical tags already point at the real domain;
# this keeps them out of search results outright. Placeholder syntax is
# Cloudflare's: https://developers.cloudflare.com/pages/configuration/headers/
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Astro content-hashes everything under /_astro/, so a file never changes at a
# given URL. Pages' default is a 4-hour max-age; make these immutable.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
