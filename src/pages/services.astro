---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import { heroImage } from '../lib/hero';
import { offerCouplesCounseling, serviceImageWidths, services } from '../config/site';

import heroTree from '../assets/images/hero-tree.jpg';

const hero = await heroImage(heroTree);
---

<BaseLayout
  title="Services"
  description={`Individual counseling${offerCouplesCounseling ? ', couples counseling,' : ''} and trauma therapy with Brandon Johnson, LMFT/LMHC, in SE Portland and remotely across Oregon and Washington.`}
  preloadImage={hero}
>
  <PageHero
    title="There’s a way forward, and finding it can be difficult. I’m here so we can do it together."
    hero={hero}
  />

  <section class="section">
    <div class="container">
      <h2 class="center">My services</h2>
      <div class="services">
        {
          services.map((service) => (
            <article class="service">
              <Image src={service.image} alt={service.alt} widths={serviceImageWidths} width={serviceImageWidths.at(-1)} sizes="(max-width: 48rem) 90vw, 26rem" />
              <div class="service__text prose">
                <h3>{service.title}</h3>
                <p>{service.body}</p>
                {service.note && <p><strong>{service.note}</strong></p>}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection heading="Questions before getting started? Get in touch." />
</BaseLayout>

<style>
  .services {
    display: grid;
    gap: var(--space-xl);
    margin-top: var(--space-lg);
  }

  .service {
    display: grid;
    gap: var(--space-md);
    align-items: center;
  }

  .service h3 {
    margin-top: 0;
  }

  @media (min-width: 52rem) {
    .service {
      grid-template-columns: 24rem 1fr;
      gap: var(--space-lg);
    }

    /* Alternate the image side so the column doesn't read as a list of rows. */
    .service:nth-child(even) > :global(img) {
      order: 2;
    }
  }
</style>
