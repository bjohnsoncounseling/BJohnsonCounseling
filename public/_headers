# Cloudflare Pages security headers. Applied to every response.
# https://developers.cloudflare.com/pages/configuration/headers/
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # 'unsafe-inline' is kept for the inline JSON-LD block. The contact form's
  # script is bundled (external) now, so the only other inline script is the
  # Turnstile loader tag, which is a src= reference. Dropping 'unsafe-inline'
  # should work once verified against the live Turnstile widget. The one
  # third-party origin allowed is challenges.cloudflare.com — the Turnstile
  # widget (its script, its verification XHR via connect-src, and the iframe
  # it renders via frame-src). Everything else stays locked to 'self'.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests

# The *.pages.dev deployments (production alias and every branch preview) are
# public copies of the site. Canonical tags already point at the real domain;
# this keeps them out of search results outright. Placeholder syntax is
# Cloudflare's: https://developers.cloudflare.com/pages/configuration/headers/
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Astro content-hashes everything under /_astro/, so a file never changes at a
# given URL. Pages' default is a 4-hour max-age; make these immutable.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
