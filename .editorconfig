# Editor defaults for this repo (https://editorconfig.org). Matches what the
# existing files use: two-space indent, LF, UTF-8, trailing newline.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
