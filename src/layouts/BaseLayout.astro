---
import '@fontsource-variable/pontano-sans';
import '@fontsource-variable/eb-garamond';
import '../styles/global.css';
// The Latin subsets are the only font files an English page loads (the rest
// are gated by unicode-range), and they are preloaded below so the first paint
// doesn't swap from the fallback face. `?url` yields the same hashed file the
// package's @font-face rules point at.
import pontanoSansLatin from '@fontsource-variable/pontano-sans/files/pontano-sans-latin-wght-normal.woff2?url';
import ebGaramondLatin from '@fontsource-variable/eb-garamond/files/eb-garamond-latin-wght-normal.woff2?url';

import { getImage } from 'astro:assets';
import type { GetImageResult } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { address, addressOneLine, areaServed, contact, practitioner, rates, services, site } from '../config/site';
import ogSource from '../assets/images/hero-tree.jpg';

interface Props {
  title: string;
  description?: string;
  /** Set on the homepage only, so the site name isn't duplicated in the tab. */
  bareTitle?: boolean;
  /**
   * The page's hero photo, from `heroImage()` in src/lib/hero.ts. It is the
   * largest contentful paint wherever it appears, so it is preloaded from
   * `<head>` instead of waiting for the parser to reach the `<img>`.
   */
  preloadImage?: GetImageResult;
}

const { title, description = site.description, bareTitle = false, preloadImage } = Astro.props;

const pageTitle = bareTitle ? title : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).href;

/**
 * The link-preview image: today the same tree as the hero. To ship a branded
 * card (1200 x 630 with the mountain mark and the practice name) point the
 * `ogSource` import at the new file; its dimensions are read from the file,
 * so the og:image:width/height tags and the alt below are all that change.
 */
const og = await getImage({ src: ogSource, format: 'jpg', width: ogSource.width });
const ogImage = new URL(og.src, site.url).href;
const ogImageAlt = 'A broad oak tree in full leaf, backlit by low sun over a park lawn.';

/** Numeric dollar amount of a `rates` price such as "$175". */
const dollars = (price: string) => Number(price.replace(/[^\d.]/g, ''));
const prices = rates.map((r) => dollars(r.price));
const priceRange = prices.length > 1 ? `$${Math.min(...prices)}-$${Math.max(...prices)}` : rates[0].price;

/**
 * Structured data, built from src/config/site.ts so it cannot drift from the
 * visible page. The Squarespace original advertised a stale Oregon City address
 * and listed Squarespace's own social accounts as this practice's profiles;
 * both are corrected here, and `sameAs` is omitted since there are no profiles.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LocalBusiness', 'MedicalBusiness'],
      '@id': `${site.url}/#practice`,
      name: site.name,
      url: site.url,
      image: ogImage,
      logo: `${site.url}/icon-512.png`,
      email: contact.email,
      telephone: contact.phone,
      faxNumber: contact.fax,
      priceRange,
      // schema.org's MedicalSpecialty has no counseling value; this is the nearest.
      medicalSpecialty: 'Psychiatric',
      address: {
        '@type': 'PostalAddress',
        streetAddress: address.street,
        addressLocality: address.city,
        addressRegion: address.state,
        postalCode: address.zip,
        addressCountry: address.country,
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: 45.5189136,
        longitude: -122.5756095,
      },
      hasMap: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(addressOneLine)}`,
      areaServed: areaServed.map((name) => ({ '@type': 'State', name })),
      founder: { '@id': `${site.url}/#brandon` },
      makesOffer: rates.map((r) => ({
        '@type': 'Offer',
        price: dollars(r.price),
        priceCurrency: 'USD',
        itemOffered: {
          '@type': 'Service',
          name: r.title,
          description: r.body,
          provider: { '@id': `${site.url}/#practice` },
        },
      })),
    },
    {
      '@type': 'Person',
      '@id': `${site.url}/#brandon`,
      name: practitioner.name,
      honorificSuffix: practitioner.degree,
      jobTitle: practitioner.licenses.map((l) => l.title),
      email: contact.email,
      telephone: contact.phone,
      worksFor: { '@id': `${site.url}/#practice` },
      knowsAbout: services.map((s) => s.title),
      hasCredential: practitioner.licenses.map((l) => ({
        '@type': 'EducationalOccupationalCredential',
        credentialCategory: 'license',
        name: `${l.title} (${l.state} #${l.number})`,
        recognizedBy: { '@type': 'GovernmentOrganization', name: l.board.name, url: l.board.url },
      })),
    },
  ],
};

// `set:html` doesn't escape, and "</script>" inside a JSON string would end the
// block early. Everything here is static config today; this keeps it safe if a
// value ever comes from somewhere else.
const jsonLdHtml = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadImage.src}
        imagesrcset={preloadImage.srcSet.attribute}
        imagesizes={preloadImage.attributes.sizes}
        fetchpriority="high"
      />
    )}
    <link rel="preload" as="font" type="font/woff2" href={pontanoSansLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={ebGaramondLatin} crossorigin />

    {/* Favicon set generated from Brandon's 751px mountain mark (Browser Icon.png). */}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#dcd9d0" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogSource.width)} />
    <meta property="og:image:height" content={String(ogSource.height)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={jsonLdHtml} is:inline />
  </head>

  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
